<odoo>
    <record id="view_sgs_perdiem_import_wizard_form" model="ir.ui.view">
        <field name="name">Importar depósitos viáticos</field>
        <field name="model">sgs.perdiem.deposit.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_parse_file" string="1. Analizar Excel" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_create_deposits" string="2. Crear Depósitos" type="object" class="oe_highlight" invisible="state != 'to_conciliate'"/>
                </header>
                <sheet>
                    <group invisible="state != 'draft'">
                        <field name="file" widget="binary" filename="filename" string="Arrastra aquí tu Deposito_viaticos_sgs.xlsx"/>
                        <field name="filename" invisible="1"/>
                        <field name="date_default"/>
                    </group>
                    <field name="state" invisible="1"/>
                    <notebook invisible="state == 'draft'">
                        <page string="Conciliación" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" decoration-success="state in ('matched','matched_auto')" decoration-warning="state == 'to_conciliate'" decoration-danger="state == 'not_found'">
                                    <field name="custodio_raw" readonly="1"/>
                                    <field name="employee_id" readonly="1"/>
                                    <field name="custodian_id" options="{'no_create': True}"/>
                                    <field name="amount"/>
                                    <field name="date"/>
                                    <field name="state" widget="badge" decoration-success="state in ('matched','matched_auto')" decoration-warning="state == 'to_conciliate'" decoration-danger="state == 'not_found'"/>
                                    <field name="match_score" widget="progressbar"/>
                                    <field name="to_import" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <p class="text-muted">Amarillo = revisa manualmente. Rojo = empleado no existe en hr.employee / sgs.custodian. Puedes asignar el custodio correcto o desmarcar "Importar" para descartarlo.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sgs_perdiem_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Depósitos Viáticos</field>
        <field name="res_model">sgs.perdiem.deposit.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <menuitem id="menu_sgs_perdiem_import" name="Importar Depósitos (Excel)" parent="sgs_custody_perdiem.menu_sgs_deposits" action="action_sgs_perdiem_import_wizard" sequence="10"/>
</odoo>
