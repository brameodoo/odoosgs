<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acciones de Reportes ZPL -->
    <record id="action_report_roll_label_zpl" model="ir.actions.report">
        <field name="name">Etiqueta de Rollo (ZPL)</field>
        <field name="model">mrp.production.label</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">mrp_jkkpack_packaging_labels.report_roll_label_zpl_template</field>
        <field name="report_file">roll_label</field>
    </record>

    <record id="action_report_box_label_zpl" model="ir.actions.report">
        <field name="name">Etiqueta de Caja (ZPL)</field>
        <field name="model">mrp.production.label</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">mrp_jkkpack_packaging_labels.report_box_label_zpl_template</field>
        <field name="report_file">box_label</field>
    </record>

    <record id="action_report_pallet_master_zpl" model="ir.actions.report">
        <field name="name">Etiqueta Master Tarima (ZPL)</field>
        <field name="model">mrp.production.pallet</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">mrp_jkkpack_packaging_labels.report_pallet_master_zpl_template</field>
        <field name="report_file">pallet_master_label</field>
    </record>

    <!-- Reporte QWeb PDF para Lista de Empaque -->
    <record id="action_report_packing_list_pdf" model="ir.actions.report">
        <field name="name">Lista de Empaque (Packing List)</field>
        <field name="model">mrp.production.pallet</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mrp_jkkpack_packaging_labels.report_packing_list_pdf_template</field>
        <field name="report_file">Packing_List</field>
        <field name="binding_model_id" ref="model_mrp_production_pallet"/>
    </record>
</odoo>
