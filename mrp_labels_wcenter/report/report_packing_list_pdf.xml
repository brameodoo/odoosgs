<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_packing_list_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="pallet">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 11px;">
                        <table style="width: 100%; margin-bottom: 15px;">
                            <tr>
                                <td style="width: 50%;">
                                    <h2>JKK Pack, S.A. DE C.V.</h2>
                                    <strong><t t-esc="pallet.partner_id.name"/></strong><br/>
                                    <span>RFC: <t t-esc="pallet.partner_id.vat or 'XEXX010101000'"/></span><br/><br/>
                                    <strong><t t-esc="pallet.production_id.product_id.default_code"/></strong><br/>
                                    <span><t t-esc="pallet.production_id.product_id.name"/></span>
                                </td>
                                <td style="width: 50%; text-align: right; vertical-align: top;">
                                    <h3 style="margin-top:0;">LISTA DE EMPAQUE / PACKING LIST</h3>
                                    <span>Orden de Venta: <strong><t t-esc="pallet.sale_order_id.name"/></strong></span><br/>
                                    <span>Pedido Cliente / Customer Order: <strong><t t-esc="pallet.customer_po"/></strong></span><br/>
                                    <span>Fecha: <t t-esc="pallet.date_created.strftime('%d-%b-%Y %H:%M')"/></span><br/><br/>
                                    <h3 style="background-color: #000; color: #fff; padding: 5px;">TARIMA / PALLET: <t t-esc="pallet.name"/></h3>
                                </td>
                            </tr>
                        </table>

                        <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
                            <thead>
                                <tr style="border-bottom: 2px solid black; text-align: left;">
                                    <th style="padding: 5px;">Lote Maestro / Master Lot</th>
                                    <th style="padding: 5px;">Lote Caja / Box Lot</th>
                                    <th style="padding: 5px; text-align: right;">Peso Bruto / Gross Weight</th>
                                    <th style="padding: 5px; text-align: right;">Peso Neto / Net Weight</th>
                                    <th style="padding: 5px; text-align: right;">Cantidad x Caja / Qty per Box</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="pallet.label_box_ids" t-as="box">
                                    <tr style="border-bottom: 1px solid #ccc;">
                                        <td style="padding: 4px;"><t t-esc="box.master_roll_ref"/></td>
                                        <td style="padding: 4px;"><t t-esc="box.name"/></td>
                                        <td style="padding: 4px; text-align: right;"><t t-esc="'%.2f' % box.gross_weight"/></td>
                                        <td style="padding: 4px; text-align: right;"><t t-esc="'%.2f' % box.weight"/></td>
                                        <td style="padding: 4px; text-align: right;"><t t-esc="'%.2f' % box.qty_per_box"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="border-top: 2px solid black; font-weight: bold;">
                                    <td colspan="2" style="padding: 6px;">TOTALES:</td>
                                    <td style="padding: 6px; text-align: right;"><t t-esc="'%.2f' % pallet.gross_weight"/></td>
                                    <td style="padding: 6px; text-align: right;"><t t-esc="'%.2f' % pallet.net_weight"/></td>
                                    <td style="padding: 6px; text-align: right;"><t t-esc="'%.2f' % pallet.total_qty"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
