<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_label_wizard_form" model="ir.ui.view">
        <field name="name">mrp.production.label.wizard.form</field>
        <field name="model">mrp.production.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Pesaje, Etiquetado y Empaque JKKPack">
                <sheet>
                    <group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="workcenter_id" options="{'no_create': True}"/>
                            <field name="is_final_packaging"/>
                        </group>
                        <group>
                            <field name="mo_expected_weight" invisible="is_final_packaging"/>
                            <field name="qty_labels" string="N° de Cajas / Rollos"/>
                        </group>
                    </group>

                    <group invisible="not is_final_packaging" string="Datos del Empaque Secundario">
                        <group>
                            <field name="operator_name" required="is_final_packaging"/>
                            <field name="rolls_per_box"/>
                        </group>
                        <group>
                            <field name="master_roll_prefix"/>
                            <field name="box_tare_weight"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Captura de Pesos" name="weights">
                            <field name="line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence_no"/>
                                    <field name="weight" sum="Total Peso Neto"/>
                                    <field name="gross_weight" sum="Total Peso Bruto" column_invisible="not parent.is_final_packaging"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Generar e Imprimir" name="generate_and_print_labels" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
